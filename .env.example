POSTGRES_DB=nature_bazar
POSTGRES_USER=nature_bazar
POSTGRES_PASSWORD=change-this-password
API_PORT=8000
WEB_PORT=3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SUPER_ADMIN_EMAILS=you@example.com
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Header the proxy in front of the app puts the real client IP in, used for
# per-IP rate limiting: cf-connecting-ip behind Cloudflare, x-forwarded-for
# behind nginx/LiteSpeed. Runtime var: `docker compose up -d --force-recreate api`.
CLIENT_IP_HEADER=cf-connecting-ip

# Meta Pixel ID from Events Manager (leave empty to disable tracking).
# Baked into the frontend image at build time: rebuild after changing.
META_PIXEL_ID=
# Optional Google Tag Manager container (GTM-XXXXXXX). If GTM also fires the
# Meta Pixel, leave META_PIXEL_ID empty to avoid double counting.
GTM_ID=
# Conversions API access token (Events Manager > Settings > Conversions API).
# Runtime var: `docker compose up -d --force-recreate api` after changing.
META_CAPI_ACCESS_TOKEN=
# Optional: Test Events code (e.g. TEST26811). Leave empty in production.
META_TEST_EVENT_CODE=

# Pathao Courier merchant API (runtime vars: `docker compose up -d --force-recreate api`).
# Sandbox for testing: base URL below, client id 7N1aMJQbWm, secret
# wRcaibZkUdSNz2EI9ZyuXLlNrnAv0TdPUPXMnD39, username test@pathao.com,
# password lovePathao, store id 150833. Live: base URL https://api-hermes.pathao.com,
# client id/secret from merchant.pathao.com > Developer API, and your merchant
# panel login as username/password. Store id: GET /api/system/pathao lists them.
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# Weight of one unit in kg (Pathao prices by weight; times quantity, 0.5-10).
PATHAO_UNIT_WEIGHT_KG=1

# --- Products ---------------------------------------------------------------
# The catalogue lives only in the database and is edited at /admin/products.
# There is no fallback product: with nothing live the shop says it is closed.
# Where uploaded product images are written inside the api container. compose
# mounts the `media` named volume here — never point this at a path inside the
# image, or every upload is lost on the next rebuild.
MEDIA_ROOT=/app/media
# Largest accepted product image, in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# --- Landing page -----------------------------------------------------------
# The previous landing page is preserved at /legacy, which 404s for everyone
# unless this is set to 1. Keep it empty in production: it is a working copy of
# the old shop, order form included, not a static snapshot.
SHOW_LEGACY_LANDING=
