DATABASE_URL=postgresql://nature_bazar:change-this-password@db:5432/nature_bazar

# Concurrency tuning. Total DB connections = UVICORN_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW);
# keep under Postgres max_connections (default 100).
UVICORN_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:3000

# Product snapshot used for incoming orders (price is always server-side).
UNIT_PRICE=1490
